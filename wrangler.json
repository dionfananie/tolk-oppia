{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "tolk-oppia",
	"main": "./workers/app.ts",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"workers_dev": false,
	"routes": [
		{
			"pattern": "tolk.oppia.world",
			"custom_domain": true
		}
	],
	"upload_source_maps": true,
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
	},
	"d1_databases": [
		{
			"binding": "tolk_db",
			"database_name": "tolk-db",
			"database_id": "7ceb54f2-6936-4893-9560-a1cfedf48efe"
		}
	]
}
